data/raw/**
data/intermediate/**
data/processed/**

# Keep directory structure with .gitkeep
!data/raw/**/
!data/intermediate/**/
!data/processed/**/

# Dataset file types
*.csv
*.parquet
*.zip
*.pcap
*.pcapng

# =========================================================
# Generated artifacts
# =========================================================

data/artifacts/**

# Keep artifact directory structure if needed
!data/artifacts/**/
!data/artifacts/**/.gitkeep

# =========================================================
# Results
# =========================================================

outputs/
results/
logs/
*.log

# Keep report CSV files if they are intentionally tracked
!reports/**/*.csv

# =========================================================
# Python
# =========================================================

__pycache__/
*.pyc
venv/
.venv/
*.egg-info/
.pytest_cache/

# =========================================================
# Jupyter
# =========================================================

.ipynb_checkpoints/

# =========================================================
# IDE / OS
# =========================================================

.vscode/
.idea/
.DS_Store

# =========================================================
# Keep directory placeholders
# =========================================================

!.gitkeep
!**/.gitkeep


