# Datasets: ignore all contents, but keep the directory tree via .gitkeep.
# The '!.../**/' line re-includes directories so git descends into them;
# without it an excluded parent hides the .gitkeep inside it.
data/raw/**
data/interim/**
data/processed/**
!data/raw/**/
!data/interim/**/
!data/processed/**/
*.csv
*.parquet
*.zip

# ...but results are evidence, not data. They carry provenance (seed, hardware,
# library versions, git commit) and no filesystem paths, so they are tracked.
!reports/**/*.csv

__pycache__/
*.pyc
venv/
.venv/
*.egg-info/
.pytest_cache/

.ipynb_checkpoints/

.DS_Store

.vscode/
.idea/

outputs/
*.log

# --- keep the directory tree in a fresh clone ---
!.gitkeep
!**/.gitkeep
